generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum BookingStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  EXPIRED
  CANCELLED
  REJECTED
}

enum ProviderStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  AWAITING_CONFIRMATION
  CONFIRMED
  PAID
  DISPUTED
  CANCELLED
  REFUNDED
  CANCELLATION_FEE
}

enum PaymentMethod {
  CASH
  MANUAL
  ESEWA
  KHALTI
  BANK_TRANSFER
}

enum PayoutStatus {
  PENDING
  SETTLED
  HOLD
  CANCELLED
}

enum DispatchState {
  QUEUED
  SEARCHING
  NOTIFIED
  MATCHED
  EXPIRED
  DIRECT
}

model User {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  password        String
  phone           String   @unique
  role            Role     @default(CUSTOMER)
  isActive        Boolean  @default(true)
  isEmailVerified Boolean  @default(false)
  avatar          String?
  avatarPublicId  String?

  // Permanent Address
  province      String?
  district      String?
  municipality  String?
  ward          String?
  streetAddress String?

  // Temporary Address
  tempProvince      String?
  tempDistrict      String?
  tempMunicipality  String?
  tempWard          String?
  tempStreetAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providerProfile  ProviderProfile?
  customerBookings Booking[]        @relation("CustomerBookings")
  providerBookings Booking[]        @relation("ProviderBookings")
  reviewsGiven     Review[]         @relation("ReviewAuthor")
  refreshTokens    RefreshToken[]
  notifications    Notification[]
  pushSubscriptions PushSubscription[]
  customerPayments Payment[]        @relation("CustomerPayments")
  providerPayments Payment[]        @relation("ProviderPayments")
  customerAddresses CustomerAddress[] @relation("CustomerAddresses")

  @@index([email])
  @@index([role])
  @@map("users")
}

model ProviderProfile {
  id              String         @id @default(uuid())
  userId          String         @unique
  categoryId      String
  experienceYears Int            @default(0)
  bio             String?
  expertise       String[]
  availability    String         @default("Available")

  status                   ProviderStatus @default(PENDING_APPROVAL)
  citizenshipNumber        String?
  citizenshipFront         String?
  citizenshipFrontPublicId String?
  citizenshipBack          String?
  citizenshipBackPublicId  String?
  rejectionReason          String?
  approvedAt               DateTime?
  approvedBy               String?

  totalJobs       Int     @default(0)
  averageRating   Float   @default(0)
  totalReviews    Int     @default(0)
  totalEarnings   Decimal @default(0) @db.Decimal(12, 2)
  isCurrentlyBusy Boolean @default(false)

  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  category         ServiceCategory     @relation(fields: [categoryId], references: [id])
  services         ProviderService[]
  serviceAreas     ProviderArea[]
  subCategories    ProviderSubCategory[]
  bookingNotifications ProviderBookingNotification[]

  @@index([categoryId])
  @@index([status])
  @@map("provider_profiles")
}

// Provider's coverage locations (multiple)
model ProviderArea {
  id           String   @id @default(uuid())
  providerId   String
  province     String
  district     String
  municipality String?  // null means provider covers whole district

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([province, district])
  @@index([province, district, municipality])
  @@map("provider_areas")
}

// Sub-categories provider specializes in
model ProviderSubCategory {
  id            String @id @default(uuid())
  providerId    String
  subCategoryId String

  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  subCategory SubCategory     @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)

  @@unique([providerId, subCategoryId])
  @@map("provider_sub_categories")
}

model ServiceCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String?  @unique
  description String?
  icon        String?
  imageUrl    String?
  imagePublicId String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  services         Service[]
  subCategories    SubCategory[]
  providerProfiles ProviderProfile[]

  @@map("service_categories")
}

model SubCategory {
  id          String   @id @default(uuid())
  name        String
  slug        String?  @unique
  description String?
  icon        String?
  categoryId  String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  category            ServiceCategory       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  services            Service[]
  providerSubCategories ProviderSubCategory[]

  @@unique([name, categoryId])
  @@index([categoryId])
  @@map("sub_categories")
}

model Service {
  id            String  @id @default(uuid())
  name          String
  slug          String? @unique
  description   String
  basePrice     Decimal @db.Decimal(10, 2)
  image         String?
  imagePublicId String?
  categoryId    String
  subCategoryId String?
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category         ServiceCategory   @relation(fields: [categoryId], references: [id])
  subCategory      SubCategory?      @relation(fields: [subCategoryId], references: [id])
  providerServices ProviderService[]
  bookings         Booking[]

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([isActive])
  @@map("services")
}

model ProviderService {
  id          String   @id @default(uuid())
  providerId  String
  serviceId   String
  customPrice Decimal? @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service  Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([providerId, serviceId])
  @@map("provider_services")
}

model CustomerAddress {
  id            String   @id @default(uuid())
  customerId    String

  label         String?
  fullName      String?
  phone         String?

  province      String
  district      String
  municipality  String
  ward          String?
  streetAddress String
  landmark      String?

  latitude      Float?
  longitude     Float?

  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer User @relation("CustomerAddresses", fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([province, district, municipality])
  @@map("customer_addresses")
}

model Booking {
  id          String        @id @default(uuid())
  bookingCode String        @unique @default(cuid())
  customerId  String
  providerId  String?
  serviceId   String
  status      BookingStatus @default(PENDING)

  scheduledTime DateTime
  scheduledEndTime DateTime?
  address       String
  province      String?
  district      String?
  municipality  String?
  latitude      Float?
  longitude     Float?
  notes         String?
  addressLabel         String?
  contactName          String?
  contactPhone         String?

  addressProvince      String?
  addressDistrict      String?
  addressMunicipality  String?
  addressWard          String?
  addressStreet        String?
  addressLandmark      String?

  addressLatitude      Float?
  addressLongitude     Float?

  basePrice       Decimal  @db.Decimal(10, 2)
  totalPrice      Decimal  @db.Decimal(10, 2)
  cancellationFee Decimal? @db.Decimal(10, 2)
  estimatedAmount Decimal? @db.Decimal(10, 2)
  finalAmount Decimal? @db.Decimal(10, 2)
  providerProposedAmount Decimal? @db.Decimal(10, 2)
  providerCompletionNote String?
  customerConfirmedAt DateTime?

  paymentStatus PaymentStatus @default(PENDING)
  paidAt        DateTime?
  paymentMethod String?
  dispatchState DispatchState?
  currentDispatchBatch Int?
  dispatchQueuedAt DateTime?
  dispatchStartedAt DateTime?

  cancelReason String?
  cancelledAt  DateTime?
  cancelledBy  String?

  completedAt DateTime?
  startedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer User    @relation("CustomerBookings", fields: [customerId], references: [id])
  provider User?   @relation("ProviderBookings", fields: [providerId], references: [id])
  service  Service @relation(fields: [serviceId], references: [id])
  review   Review?
  payment  Payment?
  receipt  Receipt?
  statusHistory BookingStatusHistory[]
  providerNotifications ProviderBookingNotification[]

  @@index([customerId])
  @@index([providerId])
  @@index([status])
  @@index([scheduledTime])
  @@index([addressProvince, addressDistrict, addressMunicipality])
  @@map("bookings")
}

model Review {
  id             String   @id @default(uuid())
  bookingId      String   @unique
  authorId       String
  rating         Float
  comment        String?
  photos         String[]
  photoPublicIds String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  author  User    @relation("ReviewAuthor", fields: [authorId], references: [id])

  @@map("reviews")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?  // Path to redirect when clicked
  actionUrl String?
  data      Json?
  metadata  Json?
  priority  String   @default("NORMAL")
  isRead    Boolean  @default(false)
  isArchived Boolean @default(false)
  archivedAt DateTime?
  expiresAt  DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([userId, isArchived])
  @@index([userId, isRead])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("notifications")
}

model PushSubscription {
  id           String   @id @default(cuid())
  userId       String
  endpoint     String   @unique
  p256dh       String
  auth         String
  userAgent    String?
  isActive     Boolean  @default(true)
  lastUsedAt   DateTime?
  failedAt     DateTime?
  failureCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@map("push_subscriptions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model NepalLocation {
  id           String @id @default(uuid())
  province     String
  district     String
  municipality String

  @@unique([province, district, municipality])
  @@index([province])
  @@index([district])
  @@map("nepal_locations")
}

model BookingStatusHistory {
  id          String        @id @default(uuid())
  bookingId   String
  status      BookingStatus
  actorUserId String?
  actorRole   Role?
  message     String?
  createdAt   DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
  @@index([createdAt])
  @@map("booking_status_history")
}

model ProviderBookingNotification {
  id                String         @id @default(uuid())
  bookingId         String
  providerProfileId String
  status            String
  batchNumber       Int            @default(1)
  expiresAt         DateTime?
  respondedAt       DateTime?
  createdAt         DateTime       @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([providerProfileId])
  @@index([status])
  @@map("provider_booking_notifications")
}

model FAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String
  section   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section, isActive])
  @@map("faqs")
}

model SupportMessage {
  id           String   @id @default(uuid())
  ticketCode   String   @unique @default(cuid())
  fullName     String
  email        String
  phone        String?
  topic        String?
  subject      String
  message      String
  status       String   @default("OPEN")
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([topic])
  @@index([createdAt])
  @@map("support_messages")
}

model Payment {
  id                    String        @id @default(uuid())
  bookingId              String        @unique
  customerId             String
  providerId             String?
  grossAmount            Decimal?      @db.Decimal(10, 2)
  estimatedAmount        Decimal?      @db.Decimal(10, 2)
  providerProposedAmount Decimal?      @db.Decimal(10, 2)
  finalAmount            Decimal?      @db.Decimal(10, 2)
  platformFeePercent     Decimal       @default(10.00) @db.Decimal(5, 2)
  platformFeeAmount      Decimal?      @db.Decimal(10, 2)
  providerEarningAmount  Decimal?      @db.Decimal(10, 2)
  paymentMethod          PaymentMethod @default(CASH)
  paymentStatus          PaymentStatus @default(PENDING)
  payoutStatus           PayoutStatus  @default(PENDING)
  providerNote           String?
  customerNote           String?
  disputeReason          String?
  adminNote              String?
  proposedAt             DateTime?
  confirmedAt            DateTime?
  paidAt                 DateTime?
  disputedAt             DateTime?
  settledAt              DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer User    @relation("CustomerPayments", fields: [customerId], references: [id])
  provider User?   @relation("ProviderPayments", fields: [providerId], references: [id])
  receipt  Receipt?

  @@index([customerId])
  @@index([providerId])
  @@index([paymentStatus])
  @@index([payoutStatus])
  @@map("payments")
}

model Receipt {
  id                   String        @id @default(uuid())
  receiptNumber        String        @unique
  paymentId            String        @unique
  bookingId            String        @unique
  customerId           String
  providerId           String?
  currency             String        @default("NPR")
  grossAmount          Decimal?      @db.Decimal(10, 2)
  finalAmount          Decimal?      @db.Decimal(10, 2)
  platformFeeAmount    Decimal?      @db.Decimal(10, 2)
  providerEarningAmount Decimal?     @db.Decimal(10, 2)
  paymentMethod        PaymentMethod?
  paymentCompletedAt   DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([providerId])
  @@index([paymentCompletedAt])
  @@map("receipts")
}
